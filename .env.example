# Project-local examples
NETSTITCH__ENV=development
NETSTITCH__LOG_LEVEL=info
# Optional: explicit WinDivert DLL path for UDP/QUIC FLOW capture on Windows.
# NETSTITCH__WINDIVERT_DLL=C:\Tools\WinDivert\x64\WinDivert.dll

# External providers
PROVIDER__API_BASE_URL=
PROVIDER__API_TOKEN=

# Optional community cloud sync placeholders. Real project-local values belong in
# ignored files such as .env.cloudflare.local, not in git.
# NETSTITCH__COMMUNITY_API_URL=https://<worker-name>.<workers-subdomain>.workers.dev
# PROVIDER__CLOUDFLARE__D1_DATABASE_NAME=<database-name>
# PROVIDER__CLOUDFLARE__D1_DATABASE_ID=<database-id>
# PROVIDER__CLOUDFLARE__D1_BINDING=DB
# PROVIDER__GOOGLE__OAUTH_CLIENT_ID=<google-oauth-client-id>
# PROVIDER__GOOGLE__OAUTH_REDIRECT_URI=https://<worker-host>/v1/auth/google/callback
# PROVIDER__TURNSTILE__SITE_KEY=<turnstile-site-key>
# Google OAuth client secret, identity pepper, and Turnstile secret key are
# Cloudflare Worker secrets, not tracked env values. Upload them with Wrangler
# secret put from an ignored local contour.
# Required Worker secrets:
# NETSTITCH_GOOGLE_CLIENT_SECRET
# NETSTITCH_IDENTITY_PEPPER

# Machine-local examples
LOCAL__WORKSPACE_HINT=
